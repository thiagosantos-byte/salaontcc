# Local server port. Render supplies PORT automatically.
PORT=3000
NODE_ENV=development

# Set this to use Supabase PostgreSQL; leave blank for local SQLite.
DATABASE_URL=
DB_POOL_MAX=5

# Optional TLS settings for PostgreSQL.
# PGSSL=disable
# PGSSL_REJECT_UNAUTHORIZED=false

# Local SQLite file (used when DATABASE_URL is blank).
SALAON_DB_PATH=./data/salaon.sqlite

# Optional: compatible Chat Completions provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Demo owner account; set a strong private password before running the seed.
SALAON_DEMO_EMAIL=dona@salaon.local
SALAON_DEMO_PASSWORD=
